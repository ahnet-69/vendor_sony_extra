allow platform_app vendor_hal_idd_hwservice:hwservice_manager find;
allow platform_app vendor_hal_idd_default:binder call;

allow platform_app hal_somc_charger_hwservice:hwservice_manager find;

allow platform_app system_prop:property_service set;

allow platform_app vendor_sysfs_usb_supply:dir search;
allow platform_app vendor_sysfs_battery_supply:dir search;
allow platform_app vendor_sysfs_graphics:dir search;

allow platform_app vendor_sysfs_usb_supply:file { read open getattr };
allow platform_app vendor_sysfs_battery_supply:file { read open getattr };
allow platform_app vendor_sysfs_graphics:file { read open getattr };

allow platform_app sysfs_zram:dir search;
